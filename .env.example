# Copy privately to .env; keep credentials outside source control.
HELPER_IMAGE=ghcr.io/tammuzgreeen/arm-companion:0.3.7-beta
HELPER_BIND=127.0.0.1
HELPER_PORT=8080
HELPER_UID=1000
HELPER_GID=1000
OPTICAL_GID=24
VIDEO_GID=44
ARM_NETWORK=arm-network
ARM_URL=http://arm-rippers:8080
ARM_DRIVE=/dev/sr0
CAMERA_DEVICE=/dev/video0
STATE_DIRECTORY=./private/state
MEDIA_DIRECTORY=./private/media
GUI_PASSWORD_FILE=./private/gui_password
OLLAMA_URL=http://model-host:11434
LOCAL_VISION_MODELS=qwen3-vl:30b-a3b-instruct-q4_K_M,qwen2.5vl:7b-q8_0
TV_MIN_LENGTH_SECONDS=900
# External paid fallback stays disabled by default.
FALLBACK_MAX_CALLS=0
FALLBACK_SPENDING_LIMIT_USD=0

# Copy privately to .env; keep credentials outside source control.
HELPER_IMAGE=ghcr.io/tammuzgreeen/arm-companion:0.3.7-beta
HELPER_BIND=127.0.0.1
HELPER_PORT=8080
HELPER_UID=1000
HELPER_GID=1000
OPTICAL_GID=24
VIDEO_GID=44
ARM_NETWORK=arm-network
ARM_URL=http://arm-rippers:8080
ARM_DRIVE=/dev/sr0
CAMERA_DEVICE=/dev/video0
STATE_DIRECTORY=./private/state
MEDIA_DIRECTORY=./private/media
GUI_PASSWORD_FILE=./private/gui_password
OLLAMA_URL=http://model-host:11434
LOCAL_VISION_MODELS=qwen3-vl:30b-a3b-instruct-q4_K_M,qwen2.5vl:7b-q8_0
TV_MIN_LENGTH_SECONDS=900
# External paid fallback stays disabled by default.
FALLBACK_MAX_CALLS=0
FALLBACK_SPENDING_LIMIT_USD=0

# Experimental local transfer: append these keys to the SAME private helper .env.
TRANSFER_ENABLED=false
TRANSFER_DRY_RUN=true
TRANSFER_INTERVAL_SECONDS=60
TRANSFER_DELETE_SOURCE=false
TRANSFER_VERIFY=sha256
TRANSFER_SOURCE_ROOT=/media/released
TRANSFER_STATE_DIR=/state/transfers
TRANSFER_MOVIES_DIR=/transfer/movies
TRANSFER_TV_DIR=/transfer/tv
TRANSFER_MUSIC_DIR=/transfer/music
TRANSFER_AUDIOBOOKS_DIR=/transfer/audiobooks
# Exact ZFS dataset sources reported by /proc/self/mountinfo inside the container.
# Set private values before enabling, e.g. pool/library/movies (not a host path).
TRANSFER_MOVIES_DATASET=
TRANSFER_TV_DATASET=
TRANSFER_MUSIC_DATASET=
TRANSFER_AUDIOBOOKS_DATASET=
# /dev/null placeholders keep the existing disabled deployment usable. Replace
# privately with existing mounted dataset directories; missing paths are NOT created.
HOST_MOVIES_PATH=/dev/null
HOST_TV_PATH=/dev/null
HOST_MUSIC_PATH=/dev/null
HOST_AUDIOBOOKS_PATH=/dev/null
TRANSFER_DESTINATIONS_READ_ONLY=true
# Supplemental destination-access group; operator chooses the actual group ID.
TRANSFER_GID=1000
